{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "jx3.ai-kill-report.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "insufficient_evidence"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 24
        }
      },
      "required": [
        "text",
        "claimIds"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "category": {
            "type": "string",
            "enum": [
              "death_cause",
              "offense_strength",
              "defense_gap",
              "timeline",
              "context"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 1,
            "maxItems": 24
          },
          "counterEvidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 0,
            "maxItems": 24
          },
          "mechanicRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 0,
            "maxItems": 24
          },
          "reasoningSummary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 350
            },
            "minItems": 0,
            "maxItems": 12
          }
        },
        "required": [
          "id",
          "category",
          "level",
          "text",
          "evidenceRefs",
          "counterEvidenceRefs",
          "mechanicRefs",
          "reasoningSummary",
          "limitations"
        ]
      },
      "minItems": 0,
      "maxItems": 24
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whyDied": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 24
        },
        "offenseDidWell": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 24
        },
        "defenseGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 24
        }
      },
      "required": [
        "whyDied",
        "offenseDidWell",
        "defenseGaps"
      ]
    },
    "sectionNotes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whyDied": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            {
              "type": "null"
            }
          ]
        },
        "offenseDidWell": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            {
              "type": "null"
            }
          ]
        },
        "defenseGaps": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "whyDied",
        "offenseDidWell",
        "defenseGaps"
      ]
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "atMs": {
            "type": "integer",
            "minimum": 0
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "maxItems": 24
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 1,
            "maxItems": 8
          }
        },
        "required": [
          "atMs",
          "line",
          "claimIds",
          "evidenceRefs"
        ]
      },
      "minItems": 0,
      "maxItems": 8
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "basisClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 12
          },
          "conditional": {
            "type": "boolean"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 0,
            "maxItems": 12
          },
          "mechanicRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 0,
            "maxItems": 24
          }
        },
        "required": [
          "text",
          "basisClaimIds",
          "conditional",
          "requirements",
          "mechanicRefs"
        ]
      },
      "minItems": 0,
      "maxItems": 8
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "relatedClaimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "maxItems": 24
          },
          "neededEvidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "required": [
          "text",
          "relatedClaimIds",
          "neededEvidence"
        ]
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "summary",
    "claims",
    "sections",
    "sectionNotes",
    "timeline",
    "recommendations",
    "uncertainties"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jx3:ai-kill-report:v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "minItems": 1
          },
          "summary": {
            "properties": {
              "claimIds": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
