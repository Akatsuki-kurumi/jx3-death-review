{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gameplayReference": {
      "type": "object",
      "required": ["entryId", "spec", "scene", "citations", "catalogHash"],
      "properties": {
        "entryId": { "type": "string", "pattern": "^[A-Z]+-[DC][0-9]+$" },
        "spec": { "type": "string", "maxLength": 80 },
        "scene": { "enum": ["other_pvp_only", "basic_demo_level_30", "arena_or_general_pvp_reference"] },
        "catalogHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "citations": { "type": "array", "minItems": 1, "maxItems": 20, "items": {
          "type": "object", "required": ["bvid", "part", "startSeconds", "endSeconds", "url", "timeLabel"],
          "properties": {
            "bvid": { "type": "string", "pattern": "^BV[A-Za-z0-9]+$" },
            "part": { "type": "integer", "minimum": 1 },
            "startSeconds": { "type": "integer", "minimum": 0 },
            "endSeconds": { "type": "integer", "minimum": 1 },
            "url": { "type": "string", "pattern": "^https://www\\.bilibili\\.com/video/BV[A-Za-z0-9]+/\\?p=[0-9]+&t=[0-9]+$" },
            "timeLabel": { "type": "string", "maxLength": 80 }
          }
        }}
      }
    },
    "collection": {
      "enum": [
        "game_fact",
        "ai_experience"
      ]
    },
    "priority": {
      "enum": [
        "primary",
        "reference"
      ]
    },
    "schemaVersion": {
      "const": "jx3.ai-knowledge.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "mechanic",
        "tactic_hypothesis",
        "parser_rule",
        "monitor_tag",
        "resource_description",
        "analysis_method"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "sourced",
        "verified",
        "conflicted",
        "deprecated",
        "rejected"
      ]
    },
    "client": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "gameVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "validFrom": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "validTo": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "resourceKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "skill",
              "buff",
              "kungfu",
              "talent"
            ]
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "level": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "level"
        ]
      },
      "minItems": 0,
      "maxItems": 20
    },
    "resourceFetchedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "minItems": 0,
      "maxItems": 20
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "refId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "resource",
              "event",
              "parser_rule",
              "user_feedback",
              "primary_document"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "contentHash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "retrievedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "refId",
          "kind",
          "origin",
          "contentHash",
          "retrievedAt"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "program",
            "model",
            "user"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actorKind": {
              "type": "string",
              "enum": [
                "human",
                "maintained_rule"
              ]
            },
            "actorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "sourceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "minItems": 1,
              "maxItems": 20
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            }
          },
          "required": [
            "actorKind",
            "actorId",
            "at",
            "sourceRefs",
            "note"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "conflictsWith": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "minItems": 0,
      "maxItems": 20
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "kind",
    "statement",
    "status",
    "client",
    "gameVersion",
    "validFrom",
    "validTo",
    "resourceKeys",
    "conditions",
    "sources",
    "createdBy",
    "createdAt",
    "updatedAt",
    "review",
    "conflictsWith",
    "supersedes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jx3:ai-knowledge:v1",
  "allOf": [
    {
      "if": { "required": ["gameplayReference"] },
      "then": { "properties": {
        "collection": { "const": "game_fact" },
        "kind": { "const": "tactic_hypothesis" },
        "status": { "enum": ["sourced", "deprecated", "rejected", "conflicted"] },
        "review": { "type": "null" }
      }, "required": ["collection"] }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "collection"
        ],
        "properties": {
          "collection": {
            "const": "game_fact"
          }
        }
      },
      "then": {
        "properties": {
          "priority": {
            "const": "primary"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "collection"
        ],
        "properties": {
          "collection": {
            "const": "ai_experience"
          }
        }
      },
      "then": {
        "properties": {
          "priority": {
            "const": "reference"
          },
          "status": {
            "enum": [
              "candidate",
              "sourced",
              "conflicted",
              "deprecated",
              "rejected"
            ]
          },
          "review": {
            "type": "null"
          }
        }
      }
    }
  ]
}
